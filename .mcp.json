{
  "mcpServers": {
    "api": {
      "command": "node",
      "args": ["${CLAUDE_PLUGIN_ROOT}/mcp-server/dist/index.js"],
      "env": {
        "KANON_CFG_URL": "${user_config.server_url}",
        "KANON_CFG_TOKEN": "${user_config.api_token}",
        "KANON_CFG_REPO_SLUG": "${user_config.repo_slug}",
        "KANON_PLUGIN_ROOT": "${CLAUDE_PLUGIN_ROOT}"
      }
    }
  }
}
