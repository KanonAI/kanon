      "type": "object",
      "properties": {
        "repoSlug": {
          "type": "string",
          "minLength": 1
        },
        "domainKey": {
          "type": "string",
          "minLength": 1
        },
        "featureKey": {
          "type": "string",
          "minLength": 1
        },
        "commitSha": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$"
        },
        "dirty": {
          "type": "boolean"
        },
        "capturedAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z))$"
        },
        "agent": {
          "type": "object",
          "properties": {
            "harness": {
              "type": "string",
              "const": "claude-code"
            },
            "model": {
              "type": "string",
              "minLength": 1
            },
            "pluginVersion": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "harness",
            "model",
            "pluginVersion"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "repoSlug",
        "domainKey",
        "featureKey",
        "commitSha",
        "dirty",
        "capturedAt",
        "agent"
      ],
      "additionalProperties": false
